{
  "id": "camr-gate",
  "name": "CAMR gate",
  "description": "After an edit, shows the model the decisions kept in CAMR's Ledger that the change rests on, once per change.",
  "activation": { "onStartup": true },
  "contracts": { "agentToolResultMiddleware": ["openclaw"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "camr": { "type": "string" },
      "vault": { "type": "string" },
      "stateDir": { "type": "string" }
    },
    "required": ["vault"]
  }
}
