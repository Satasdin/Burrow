diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..ec62aa9 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,25 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference as passengers tend to mean it: letters and digits only, in capitals.
+
+    "tkt 2345ab", "TKT2345AB" and " Tkt-2345AB" all become "TKT2345AB".
+    """
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only (see Ledger): never by phone, amount or time.
+
+    An exact reference wins. Otherwise the reference is compared after ignoring case,
+    spaces and punctuation; if that fits no ticket, or more than one, there is no match.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    candidates = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return candidates[0] if len(candidates) == 1 else None
