diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..248ba58 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,25 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces and separators taken out: ' Tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only, never by phone, amount or time alone.
+
+    An exact reference wins. Otherwise the reference as the passenger typed it is compared with
+    case, spaces and separators ignored; that is accepted only when it names exactly one ticket
+    and the payment came from that ticket's phone.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    candidates = [ticket for ticket in store.tickets.values() if normalise_reference(ticket.id) == wanted]
+    if len(candidates) != 1 or candidates[0].phone != line.phone:
+        return None
+    return candidates[0]
