 """Working out which ticket a statement line pays for."""
 
+import re
 from typing import Optional
 
 from ..models import StatementLine, Ticket
 
+_NOT_LETTER_OR_DIGIT = re.compile(r"[^0-9A-Z]")
+
+
+def normalise_reference(reference: str) -> str:
+    """The reference as a passenger may type it: case, spaces and dashes do not count.
+
+    "tkt 2345ab", "TKT2345AB" and " Tkt-2345AB" all become "TKT2345AB".
+    """
+    return _NOT_LETTER_OR_DIGIT.sub("", (reference or "").upper())
+
 
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches on the account reference only (never phone or amount; see Ledger).
+
+    An exact reference wins. Otherwise the reference is compared with case, spaces and
+    dashes ignored; if that fits exactly one ticket, it is the one. If it fits none or
+    more than one, there is no match and the line goes to suspense.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
