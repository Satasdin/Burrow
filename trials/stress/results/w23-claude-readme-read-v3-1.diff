-"""Working out which ticket a statement line pays for."""
+"""Working out which ticket a statement line pays for.
+
+A line is matched by its account reference only (see the Ledger: no phone/amount fallback).
+Passengers often type the reference loosely ("tkt 2345ab", "TKT2345AB", " Tkt-2345AB"), so
+when there is no exact match the reference is compared with case, spaces and punctuation
+ignored. If that loose form fits more than one ticket, the line is left unmatched.
+"""
 
 from typing import Optional
 
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    return "".join(ch for ch in (reference or "") if ch.isalnum()).upper()
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket in store.tickets.values() if normalise_reference(ticket.id) == wanted]
+    return found[0] if len(found) == 1 else None
