@@ -5,5 +5,26 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference as letters and digits only, in capitals.
+
+    Passengers type the account reference by hand, so `tkt 2345ab`, `TKT2345AB` and
+    ` Tkt-2345AB` all mean the ticket `TKT-2345AB`.
+    """
+    return "".join(ch for ch in reference.upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """The ticket whose id is the line's account reference, allowing for case, spaces and dashes.
+
+    Only the reference is used; phone and amount never pick the ticket (see Ledger).
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    # Ticket ids never collide this way, but if two ever did, guessing would be the old mistake.
+    return found[0] if len(found) == 1 else None
