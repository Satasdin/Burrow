diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..fda45a4 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,25 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """Upper case with everything but letters and digits removed: ' tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(ch for ch in reference.upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """The ticket a line pays for, or None.
+
+    An exact account reference wins. Otherwise the reference is compared with case, spaces and
+    punctuation ignored; that only counts when it picks out exactly one ticket and the payment
+    came from the phone number on that ticket.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    candidates = [t for t in store.tickets.values() if normalise_reference(t.id) == wanted]
+    if len(candidates) != 1 or candidates[0].phone != line.phone:
+        return None
+    return candidates[0]
