@@ -5,5 +5,19 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces, hyphens and other punctuation ignored: ' Tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only. An exact reference wins; otherwise a typed reference that
+    differs only in case, spacing or punctuation matches, provided exactly one ticket fits."""
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    candidates = [ticket for identifier, ticket in store.tickets.items() if normalise_reference(identifier) == wanted]
+    return candidates[0] if len(candidates) == 1 else None
