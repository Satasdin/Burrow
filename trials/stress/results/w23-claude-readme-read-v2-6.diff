--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,26 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference as passengers mean it: letters and digits only, in capitals.
+
+    Passengers type `tkt 2345ab`, `TKT2345AB` or ` Tkt-2345AB` for the ticket `TKT-2345AB`.
+    """
+    return "".join(character for character in reference if character.isalnum()).upper()
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """The ticket whose id the line's account reference names, or None.
+
+    Matching is by account reference only. An exact reference wins; otherwise the reference
+    is compared with ticket ids ignoring case, spaces and punctuation. If that fits more than
+    one ticket, nothing is guessed and None is returned.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for identifier, ticket in store.tickets.items() if normalise_reference(identifier) == wanted]
+    return found[0] if len(found) == 1 else None
