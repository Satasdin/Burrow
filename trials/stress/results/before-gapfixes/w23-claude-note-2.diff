diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..d95ea3b 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,22 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces and punctuation taken out: ' Tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only, never by phone, amount or time.
+
+    An exact reference wins. Otherwise the reference as typed is compared with each ticket id once
+    case, spaces and punctuation are ignored; it counts only if exactly one ticket fits.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    fits = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return fits[0] if len(fits) == 1 else None
