diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..34ac781 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,23 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference without case, spaces or punctuation: `tkt 2345ab`, ` Tkt-2345AB` -> `TKT2345AB`."""
+    return "".join(ch for ch in reference.upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """The ticket whose id the line's account reference names.
+
+    An exact reference wins. Otherwise the reference is compared with case, spaces and punctuation
+    ignored, since passengers type the id by hand. This is still a match on the reference alone, never
+    a guess from phone, amount or time; if the loose form fits no ticket, or more than one, there is no match.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
