diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..53e6cb2 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,23 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """Drops case, spaces and punctuation, so `tkt 2345ab` and ` Tkt-2345AB` both read `TKT2345AB`."""
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Finds the ticket by account reference only, never by phone, amount or time.
+
+    An exact reference wins. Otherwise the reference is compared with case, spaces and punctuation
+    ignored; if that fits no ticket, or more than one, there is no match.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    candidates = [ticket for identifier, ticket in store.tickets.items()
+                  if normalise_reference(identifier) == wanted]
+    return candidates[0] if len(candidates) == 1 else None
