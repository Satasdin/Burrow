@@ -5,5 +5,20 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces and punctuation ignored: ' Tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(char for char in (reference or "").upper() if char.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only. Passengers type the reference by hand, so a reference
+    that differs from a ticket id only in case, spacing or punctuation still finds that ticket.
+    If the normalised reference fits more than one ticket, no ticket is returned."""
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
