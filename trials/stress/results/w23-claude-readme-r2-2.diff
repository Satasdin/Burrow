index dd05b1e..d89a43e 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,23 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces and punctuation taken out: ' Tkt-2345ab' -> 'TKT2345AB'."""
+    return "".join(ch for ch in (reference or "").upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches on the account reference only (never phone or amount, see Ledger).
+
+    An exact reference wins. Otherwise the reference is compared with case, spaces and
+    punctuation ignored, so 'tkt 2345ab' finds TKT-2345AB. If that loose form fits no
+    ticket, or more than one, the line has no ticket.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
