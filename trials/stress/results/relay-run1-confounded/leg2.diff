-"""Working out which ticket a statement line pays for."""
+"""Working out which ticket a statement line pays for.
+
+A line is matched by its account reference and nothing else (never by phone
+number or amount). Passengers type the reference by hand, so case, spaces and
+punctuation are ignored: `tkt 2345ab`, `TKT2345AB` and ` Tkt-2345AB` all name
+ticket `TKT-2345AB`. If a typed reference could name more than one ticket, it
+matches none and the line goes to suspense.
+"""
 
 from typing import Optional
 
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    return "".join(character for character in reference.upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref or "")
+    if not wanted:
+        return None
+    candidates = [ticket for ticket_id, ticket in store.tickets.items()
+                  if normalise_reference(ticket_id) == wanted]
+    return candidates[0] if len(candidates) == 1 else None
