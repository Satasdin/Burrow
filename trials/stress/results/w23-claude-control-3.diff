--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,22 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference as letters and digits only, upper case: ' tkt-2345ab' and 'TKT2345AB' both give 'TKT2345AB'."""
+    return "".join(character for character in (reference or "").upper() if character.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches on the account reference and nothing else (no phone or amount fallback; see Ledger).
+
+    An exact reference wins. Otherwise the reference is compared with case, spaces and punctuation
+    ignored, and is only accepted when exactly one ticket has that form.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [candidate for identifier, candidate in store.tickets.items() if normalise_reference(identifier) == wanted]
+    return found[0] if len(found) == 1 else None
