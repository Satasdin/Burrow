@@ -5,5 +5,24 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_ref(reference: str) -> str:
+    """The reference with case, spaces and punctuation taken out: ' tkt-2345ab' -> 'TKT2345AB'.
+
+    Ticket ids are an upper-case prefix, a hyphen and characters from ids.ALPHABET (upper case
+    letters and digits only), so no two ids normalise to the same text.
+    """
+    return "".join(ch for ch in reference.upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches on the account reference only, as typed or with case and separators ignored."""
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_ref(line.account_ref)
+    if not wanted:
+        return None
+    for ticket_id, ticket in store.tickets.items():
+        if normalise_ref(ticket_id) == wanted:
+            return ticket
+    return None
