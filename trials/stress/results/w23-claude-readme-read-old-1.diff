diff --git a/matatu/payments/matcher.py b/matatu/payments/matcher.py
index dd05b1e..6089716 100644
--- a/matatu/payments/matcher.py
+++ b/matatu/payments/matcher.py
@@ -5,5 +5,23 @@ from typing import Optional
 from ..models import StatementLine, Ticket
 
 
+def normalise_reference(reference: str) -> str:
+    """The reference with case, spaces and punctuation taken out: " Tkt-2345ab" -> "TKT2345AB"."""
+    return "".join(ch for ch in (reference or "").upper() if ch.isalnum())
+
+
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """The ticket whose id the line's account reference names.
+
+    An exact reference wins. Otherwise the reference is compared with the ticket ids
+    ignoring case, spaces and punctuation, so "tkt 2345ab" finds TKT-2345AB. If that
+    loose comparison fits no ticket, or more than one, there is no match.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [t for ticket_id, t in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
