 """Working out which ticket a statement line pays for."""
 
-from typing import Optional
+import re
+from typing import Dict, Optional
 
 from ..models import StatementLine, Ticket
 
+_NOT_LETTER_OR_DIGIT = re.compile(r"[^0-9A-Z]")
 
-def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+
+def normalise_reference(reference: str) -> str:
+    """The reference as a passenger may have typed it, reduced to upper-case letters and digits.
+
+    ``tkt 2345ab``, ``TKT2345AB`` and `` Tkt-2345AB`` all become ``TKT2345AB``.
+    """
+    return _NOT_LETTER_OR_DIGIT.sub("", (reference or "").upper())
+
+
+def reference_index(store) -> Dict[str, Optional[str]]:
+    """Normalised reference -> ticket id. A key shared by two tickets maps to None (ambiguous)."""
+    index: Dict[str, Optional[str]] = {}
+    for ticket_id in store.tickets:
+        key = normalise_reference(ticket_id)
+        index[key] = None if key in index else ticket_id
+    return index
+
+
+def ticket_for_line(store, line: StatementLine, index: Optional[Dict[str, Optional[str]]] = None) -> Optional[Ticket]:
+    """Matches by account reference only: exactly first, then ignoring case, spaces and punctuation.
+
+    A mistyped reference that could belong to more than one ticket matches none.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    key = normalise_reference(line.account_ref)
+    if not key:
+        return None
+    if index is None:
+        index = reference_index(store)
+    ticket_id = index.get(key)
+    return store.tickets.get(ticket_id) if ticket_id is not None else None
