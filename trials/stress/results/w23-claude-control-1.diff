 """Working out which ticket a statement line pays for."""
 
+import re
 from typing import Optional
 
 from ..models import StatementLine, Ticket
 
+_NOT_ALPHANUMERIC = re.compile(r"[^0-9A-Z]")
+
+
+def normalise_reference(reference: str) -> str:
+    """The reference as we compare it: upper case, with spaces, dashes and other separators dropped.
+
+    Passengers type `tkt 2345ab`, `TKT2345AB` or ` Tkt-2345AB` for the ticket `TKT-2345AB`.
+    """
+    return _NOT_ALPHANUMERIC.sub("", (reference or "").upper())
+
 
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Matches by account reference only (no phone/amount fallback, see Ledger).
+
+    An exact reference wins. Otherwise the reference is compared with the ticket ids after
+    normalising both; if that fits no ticket, or more than one, the line has no ticket.
+    """
+    exact = store.tickets.get(line.account_ref)
+    if exact is not None:
+        return exact
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [ticket for ticket_id, ticket in store.tickets.items() if normalise_reference(ticket_id) == wanted]
+    return found[0] if len(found) == 1 else None
