 """Working out which ticket a statement line pays for."""
 
+import re
 from typing import Optional
 
 from ..models import StatementLine, Ticket
 
+_NOT_ALNUM = re.compile(r"[^0-9A-Z]")
+
+
+def normalise_reference(reference: str) -> str:
+    """Reduces a typed account reference to its letters and digits, upper case.
+
+    Passengers type the reference by hand, so `tkt 2345ab`, `TKT2345AB` and
+    ` Tkt-2345AB` all mean ticket `TKT-2345AB`.
+    """
+    return _NOT_ALNUM.sub("", (reference or "").upper())
+
 
 def ticket_for_line(store, line: StatementLine) -> Optional[Ticket]:
-    return store.tickets.get(line.account_ref)
+    """Finds the ticket by account reference only (no phone/amount fallback, see Ledger).
+
+    An exact reference wins. Otherwise the reference is compared ignoring case,
+    spaces and punctuation; it counts only if exactly one ticket fits.
+    """
+    ticket = store.tickets.get(line.account_ref)
+    if ticket is not None:
+        return ticket
+    wanted = normalise_reference(line.account_ref)
+    if not wanted:
+        return None
+    found = [t for t in store.tickets.values() if normalise_reference(t.id) == wanted]
+    return found[0] if len(found) == 1 else None
